# 复制为 .env.production 后填写；不要把真实密码提交到仓库
POSTGRES_DB=ivs
POSTGRES_USER=ivs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
APP_PORT=8090
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5
IVS_VERSION=1.1.0

# 固定公网域名：DNS A/AAAA 必须指向部署服务器，80/443 对公网开放
IVS_PUBLIC_HOST=ivs.example.com
ACME_EMAIL=admin@example.com
IVS_CORS_ALLOWED_ORIGINS=https://wang66676.github.io,https://ivs.example.com

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

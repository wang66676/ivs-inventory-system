{
    email {$ACME_EMAIL}
}

{$IVS_PUBLIC_HOST} {
    encode zstd gzip

    reverse_proxy app:8090

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    log {
        output stdout
        format console
    }
}

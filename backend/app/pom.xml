<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ivs</groupId>
        <artifactId>ivs-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>ivs-app</artifactId>
    <name>Deployable Application</name>
    <dependencies>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-shared-kernel</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-platform</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-masterdata</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-inventory</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-procurement</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-sales</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-billing</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-retail</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-policy</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.ivs</groupId><artifactId>ivs-lease</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
            <!-- 绿色版单包部署：把前端 dist 打进 classpath:/static/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
